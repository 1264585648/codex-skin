{
  "name": "codex-skin",
  "version": "0.2.0",
  "description": "Chat-first runtime themes for Codex Desktop via a semantic CDP adapter.",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:wechat": "tsx src/index.ts --theme wechat",
    "dev:qq": "tsx src/index.ts --theme qq",
    "inspect": "tsx src/inspect.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
